declare
fun {ReplaceIn Expression ID NewId}
   case Expression of 
   nil then Expression
   
   [] let(Left#Right Rest) then
        let({ReplaceIn Left ID NewId}#{ReplaceIn Right ID NewId} {ReplaceIn Rest ID NewId})
   
   [] lam(T Body) then
        lam({ReplaceIn T ID NewId} {ReplaceIn Body ID NewId})
   
   [] apply(Left Right) then
        apply({ReplaceIn Left ID NewId} {ReplaceIn Right ID NewId})
   
   [] T then 
        if T == ID then NewId 
        else T 
        end
   end
end

fun {Subs Binding InExpression}
    case Binding of 
    nil then nil
    [] Id#Expression then
        {ReplaceIn {Rename InExpression} Id Expression}
    end
end