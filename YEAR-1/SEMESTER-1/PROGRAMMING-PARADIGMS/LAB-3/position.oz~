declare
fun {PositionV1 Xs Y}
   case Xs
   of nil then 0
   [] H|T then if H == Y then 1
	       else 1 + {PositionV1 T Y}
	       end
   end
end

fun {PositionV2Help Xs Y Pos}
   case Xs
   of nil then 0
   [] H|T then if H == Y then Pos
	       else {PositionV2Help T Y (Pos+1)}
	       end
   end
end

fun {PositionV2 Xs Y}
   {PositionV2Help Xs Y 1}
end


%{Browse {PositionV1 [a b c] c}}
{Browse {PositionV2 [a b c] d}}