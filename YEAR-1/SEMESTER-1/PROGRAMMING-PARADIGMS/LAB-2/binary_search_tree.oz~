declare
fun {Insert BTree Val}
   case BTree
   of nil then leaf(Val)
   [] leaf(V) then if Val < V then node(V, leaf(Val), nil)
			else node(V, nil, leaf(Val))
		   end
   [] node(V, Left, Right) then if Val < V then node(V, {Insert Left Val}, Right)
			      else node(V, Left, {Insert Right Val})
			      end
   end
end


